{
  "name": "infinite-alchemy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Infinite Alchemy: an AI-powered element-combining game. Mix two or more elements to discover anything.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npx -y netlify-cli@27.16.2 dev",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "eval:sort": "tsx scripts/eval-sort.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backfill": "tsx scripts/backfill-legacy.ts",
    "db:challenges": "tsx scripts/generate-challenges.ts",
    "db:enrich": "tsx scripts/enrich-elements.ts",
    "db:classify": "tsx scripts/classify-recognizable.ts",
    "db:purge": "tsx scripts/purge-elements.ts",
    "db:depth": "tsx scripts/recompute-depth.ts",
    "db:repair-legacy": "tsx scripts/repair-legacy.ts",
    "db:seed-e2e": "tsx scripts/seed-e2e.ts",
    "netlify": "npx -y netlify-cli@27.16.2",
    "db:check-challenges": "tsx scripts/check-challenges.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
