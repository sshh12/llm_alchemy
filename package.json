    "@netlify/functions": "6.1.1",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-virtual": "3.14.26",
    "motion": "14.10.1",
    "openai": "7.53.0",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
